-- 1. TẠO DATABASE
CREATE DATABASE IF NOT EXISTS gemachem_real_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE gemachem_real_db;

CREATE TABLE admins (
    id INT PRIMARY KEY AUTO_INCREMENT,
    username VARCHAR(50) NOT NULL,
    password VARCHAR(255) NOT NULL, 
    ho_ten VARCHAR(100),
    email VARCHAR(100),
    trang_thai TINYINT(1) DEFAULT 1
);


CREATE TABLE danh_muc (
    id_danh_muc INT PRIMARY KEY AUTO_INCREMENT,
    ten_danh_muc VARCHAR(255) NOT NULL,
    slug VARCHAR(255) UNIQUE COMMENT ,
    id_cha INT DEFAULT 0 COMMENT ,
    hinh_anh VARCHAR(255) COMMENT,
    mo_ta TEXT,
    thu_tu INT DEFAULT 0,
    hien_thi_trang_chu TINYINT(1) DEFAULT 0,
    -- Cấu hình SEO
    meta_title VARCHAR(255),
    meta_desc VARCHAR(255),
    meta_keyword VARCHAR(255),
    trang_thai TINYINT(1) DEFAULT 1
);


CREATE TABLE san_pham (
    id_san_pham INT PRIMARY KEY AUTO_INCREMENT,
    ten_san_pham VARCHAR(255) NOT NULL,
    ten_quoc_te VARCHAR(255) COMMENT ,
    slug VARCHAR(255) UNIQUE,
    id_danh_muc INT,

    ma_san_pham VARCHAR(50),
    cas_number VARCHAR(50) COMMENT 'Mã số CAS quốc tế',
    cong_thuc_hoa_hoc VARCHAR(100) COMMENT 'Ví dụ: NaOH',
    ham_luong VARCHAR(100) COMMENT 'Ví dụ: 99%, 45%',
    xuat_xu VARCHAR(100),
    quy_cach VARCHAR(100) COMMENT 'Ví dụ: 25kg/bao',
    ngoai_quan TEXT COMMENT 'Mô tả hình dáng, màu sắc',
    -- Nội dung chi tiết
    ung_dung LONGTEXT,
    bao_quan LONGTEXT,
    hinh_anh VARCHAR(255),
    album_anh JSON COMMENT 'Lưu mảng nhiều ảnh',
    -- Cấu hình hiển thị
    is_noi_bat TINYINT(1) DEFAULT 0 COMMENT 'Sản phẩm Hot hiện trang chủ',
    luot_xem INT DEFAULT 0,
    -- Cấu hình SEO
    meta_title VARCHAR(255),
    meta_desc VARCHAR(255),
    meta_keyword VARCHAR(255),
    ngay_tao DATETIME DEFAULT CURRENT_TIMESTAMP,
    trang_thai TINYINT(1) DEFAULT 1,
    FOREIGN KEY (id_danh_muc) REFERENCES danh_muc(id_danh_muc) ON DELETE SET NULL
);

CREATE TABLE bai_viet (
    id_bai_viet INT PRIMARY KEY AUTO_INCREMENT,
    tieu_de VARCHAR(255) NOT NULL,
    slug VARCHAR(255) UNIQUE,
    mo_ta_ngan TEXT,
    noi_dung LONGTEXT,
    hinh_anh VARCHAR(255),
    loai_tin ENUM('tin-tuc', 'tuyen-dung', 'du-an', 'kien-thuc') DEFAULT 'tin-tuc',
    is_noi_bat TINYINT(1) DEFAULT 0,
    ngay_dang DATETIME DEFAULT CURRENT_TIMESTAMP,
    meta_title VARCHAR(255),
    meta_desc VARCHAR(255),
    meta_keyword VARCHAR(255),
    trang_thai TINYINT(1) DEFAULT 1
);

CREATE TABLE sliders (
    id INT PRIMARY KEY AUTO_INCREMENT,
    tieu_de VARCHAR(255),
    hinh_anh VARCHAR(255) NOT NULL,
    lien_ket VARCHAR(255),
    thu_tu INT DEFAULT 0,
    trang_thai TINYINT(1) DEFAULT 1
);

CREATE TABLE doi_tac (
    id INT PRIMARY KEY AUTO_INCREMENT,
    ten_doi_tac VARCHAR(255),
    logo VARCHAR(255) NOT NULL,
    website VARCHAR(255),
    thu_tu INT DEFAULT 0
);

CREATE TABLE lien_he (
    id INT PRIMARY KEY AUTO_INCREMENT,
    ho_ten VARCHAR(100),
    email VARCHAR(100),
    so_dien_thoai VARCHAR(20),
    tieu_de VARCHAR(200),
    noi_dung TEXT,
    ngay_gui DATETIME DEFAULT CURRENT_TIMESTAMP,
    trang_thai_xu_ly TINYINT(1) DEFAULT 0 COMMENT '0: Mới, 1: Đã xem, 2: Đã liên hệ'
);

CREATE TABLE cau_hinh (
    id INT PRIMARY KEY AUTO_INCREMENT,
    ten_cong_ty VARCHAR(255),
    dia_chi_vp TEXT,
    dia_chi_kho TEXT,
    hotline VARCHAR(50),
    zalo VARCHAR(50),
    email VARCHAR(100),
    map_iframe TEXT,
    facebook_url VARCHAR(255),
    copyright TEXT,
    code_header TEXT COMMENT 'Chứa Google Analytics, Pixel...',
    code_footer TEXT COMMENT 'Chứa script chat...'
);

